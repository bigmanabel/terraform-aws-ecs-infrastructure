aws_region   = "us-east-1"
project_name = "example-ecs-platform"
image_url    = "public.ecr.aws/docker/library/nginx:stable"

# VPC configuration. Leave azs empty to use the first two available zones.
vpc_cidr = "10.0.0.0/16"
azs      = []

# Database configuration. RDS generates and stores the master password in
# Secrets Manager; do not add a password to this file.
db_username = "app_admin"

# Recovery and deletion safeguards.
deletion_protection       = true
skip_final_snapshot       = false
final_snapshot_identifier = "example-ecs-platform-final-snapshot"

# GitHub source repository for CodePipeline.
github_owner  = "your-github-user-or-org"
github_repo   = "your-application-repository"
github_branch = "main"
